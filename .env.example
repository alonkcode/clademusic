## Example environment (do not commit real secrets)
# Vite exposes only variables prefixed with VITE_.

# Supabase (client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy compatibility
VITE_SUPABASE_ANON_KEY=your_anon_key

# Spotify OAuth (optional)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=http://localhost:8080/clademusic/spotify-callback

# Other integrations (optional)
VITE_LASTFM_API_KEY=your_lastfm_api_key

# YouTube search is server-side (supabase/functions/search-youtube).
# Set it as a function secret, never as a VITE_ variable:
#   supabase secrets set YOUTUBE_API_KEY=your_youtube_api_key

# Live analysis service (optional; services/live-analysis).
# The microphone route for phones and tablets, which have no tab-audio capture.
# While this is unset the app simply reports live analysis as unavailable on
# those devices - nothing breaks. Vite inlines VITE_* at build time, so setting
# it needs a redeploy without build cache.
VITE_LIVE_ANALYSIS_WS_URL=wss://live.example.com/ws
